{"lang":"xh","game":"twin-trap","rounds":[{"sentence":"Xa udibana notitshala omnye ekuseni, uthi ____.","options":["Molo","Molweni"],"correctIdx":0,"explain":"Molo kubuliswa umntu omnye. Molweni kubuliswa abantu abaninzi."},{"sentence":"Xa ufika kubahlobo abaninzi, uthi kubo ____?","options":["Unjani","Ninjani"],"correctIdx":1,"explain":"Unjani kubuzwa umntu omnye. Ninjani kubuzwa abantu abaninzi."},{"sentence":"Incwadi oyifunayo ikule tafile, ikho ____.","options":["apha","apho"],"correctIdx":0,"explain":"Apha yindawo ekufutshane. Apho yindawo ekude."},{"sentence":"Andinako ukuphuma, nditya ____.","options":["ngoku","ngoko"],"correctIdx":0,"explain":"Ngoku lithetha eli xesha. Ngoko lithetha elo xesha okanye isiphumo."},{"sentence":"Besingekho esikolweni ____; besikhe saya emngcwabeni.","options":["izolo","ngomso"],"correctIdx":0,"explain":"Izolo lusuku oludlulileyo. Ngomso lusuku oluzayo."},{"sentence":"Abantwana badlala ____ kwendlu.","options":["ngaphandle","ngaphakathi"],"correctIdx":0,"explain":"Ngaphandle kusephandle kwendlu. Ngaphakathi kuseendlwini."},{"sentence":"____ moto ibomvu yeyotata.","options":["lo","le"],"correctIdx":1,"explain":"Le ihamba negama elithi imoto. Lo ihamba negama elithi umntu."},{"sentence":"____ qanda liqhekekile.","options":["eli","esi"],"correctIdx":0,"explain":"Eli lihamba namagama afana neqanda. Esi sihamba namagama afana nesitya."},{"sentence":"Utitshala wakho usesangweni, ____ ke.","options":["nanku","nantsi"],"correctIdx":0,"explain":"Nanku usetyenziswa ngomntu. Nantsi isetyenziswa ngento."},{"sentence":"____ sitya sesonka osifunayo.","options":["nali","nasi"],"correctIdx":1,"explain":"Nasi sihamba nesitya. Nali sihamba ngeqanda okanye ilitye."},{"sentence":"Le moto ____, ayisiyiyo kaSipho.","options":["wam","yam"],"correctIdx":1,"explain":"Yam ihamba nento efana nemoto. Wam ihamba nomntu ofana nomhlobo."},{"sentence":"Ezi ncwadi ____, musa ukuzithatha.","options":["zakhe","wakhe"],"correctIdx":0,"explain":"Zakhe zinto ezininzi