{"lang":"zh-CN","game":"false-friends","rounds":[{"foreignWord":"手紙","foreignFlag":"jp","foreignLang":"日语","englishTwin":"手纸","isReal":false,"story":"在日语里是“信、书信”。看着像“手纸”，其实和卫生纸没关系。"},{"foreignWord":"勉強","foreignFlag":"jp","foreignLang":"日语","englishTwin":"勉强","isReal":false,"story":"在日语里主要是“学习、用功”。不是中文里“不太情愿也得做”的意思。"},{"foreignWord":"約束","foreignFlag":"jp","foreignLang":"日语","englishTwin":"约定","isReal":true,"story":"这个是真的，就是“约定、约好”。朋友之间、动画台词里都很常见。"},{"foreignWord":"注意","foreignFlag":"jp","foreignLang":"日语","englishTwin":"注意","isReal":true,"story":"这个也是真的，就是“留神、注意”。路牌、通知和老师提醒里常见。"},{"foreignWord":"運動","foreignFlag":"jp","foreignLang":"日语","englishTwin":"运动","isReal":true,"story":"和中文很接近，常指运动、锻炼，也可以指社会运动。"},{"foreignWord":"愛人","foreignFlag":"jp","foreignLang":"日语","englishTwin":"爱人","isReal":false,"story":"在日语里多指情人。不是大陆中文里常说的“配偶”那个意思。"},{"foreignWord":"娘","foreignFlag":"jp","foreignLang":"日语","englishTwin":"妈妈","isReal":false,"story":"在日语里常指“女儿”或“姑娘”。不是“妈妈”的意思。"},{"foreignWord":"怪我","foreignFlag":"jp","foreignLang":"日语","englishTwin":"怪我","isReal":false,"story":"在日语里是“受伤”。不是“这事都怪我”的那个“怪我”。"},{"foreignWord":"Gift","foreignFlag":"de","foreignLang":"德语","englishTwin":"礼物","isReal":false,"story":"德语里是“毒药”。看起来像“礼物”，实际意思可一点也不温柔。"},{"foreignWord":"pain","foreignFlag":"fr","foreignLang":"法语","englishTwin":"疼痛","isReal":false,"story":"法语里是“面包”。去面包店时天天能见到，不是“疼痛”。"},{"foreignWord":"camera","foreignFlag":"it","foreignLang":"意大利语","englishTwin":"相机","isReal":false,"story":"意大利语里常是“房间”。住旅馆时很常见，不是拍照的机器。"},{"foreignWord":"hospital","foreignFlag":"es","foreignLang":"西班牙语","englishTwin":"医院","isReal":true,"story":"这个是真的，就是“医院”。旅行时看到它，基本不用猜。"}]}