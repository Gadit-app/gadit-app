// Firestore rules for Gadit.
// COPY THIS WHOLE FILE INTO Firebase Console → Firestore → Rules
// then click "Publish". Gadit's deploy pipeline doesn't ship rules
// automatically, so this is the source of truth — keep this file
// in sync with what's actually live in the console.
//
// Last updated: 2026-11-13: families and schools are read only from the browser.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }
    function isUser(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function isOwnerOf(familyId) {
      // Family owner has uid === familyId.
      return isSignedIn() && request.auth.uid == familyId;
    }
    function isMemberOf(familyId) {
      // Custom-token-signed members (kids + secondary parents) carry a
      // `familyId` claim matching the family they were paired to.
      return isSignedIn() && request.auth.token.familyId == familyId;
    }
    function isParentInFamily(familyId) {
      return isOwnerOf(familyId)
        || (isMemberOf(familyId) && request.auth.token.role == "parent");
    }

    // ─── users/{uid} ────────────────────────────────────────────────
    // Per-user state: plan, stripe data, notebook subcollection, etc.
    // Each member (including synthetic uids for paired kids) gets their
    // own users doc so existing per-uid code (notebook, history, image
    // cache) keeps working unchanged.
    match /users/{uid} {
      // Read only from the browser (2026-10-18): the account doc holds the
      // plan, subscription status, familyId, schoolId and points, and every
      // write already goes through the server (Admin SDK). A client write here
      // let anyone give themselves a paid plan or another school's access.
      allow read: if isUser(uid);
      allow write: if false;

      // Subcollections (notebook, history, ...): the same, read only. The
      // app writes them through its API routes.
      match /{document=**} {
        allow read: if isUser(uid);
        allow write: if false;
      }
    }

    // ─── families/{familyId} ────────────────────────────────────────
    // Read only from the browser (2026-11-13). The owner and paired members
    // read the family doc; every write goes through the server (Admin SDK):
    // /api/family/member adds and edits a member, the pairing routes do the
    // rest. A browser write here let an owner store any field and skip the
    // child limit.
    match /families/{familyId} {
      allow read: if isOwnerOf(familyId) || isMemberOf(familyId);
      allow write: if false;

      // families/{familyId}/members/{memberId}
      // Owner: reads every member.
      // Member (kid/parent): can read their own member doc.
      // Member (parent): can read all member docs in the family.
      match /members/{memberId} {
        allow read: if isOwnerOf(familyId)
          || (isMemberOf(familyId) && request.auth.token.role == "parent")
          || (isMemberOf(familyId) && request.auth.token.memberId == memberId);
        allow write: if false;
      }
    }

    // ─── pairingCodes/{code} ────────────────────────────────────────
    // Top-level collection used by the pair-create / pair-redeem API
    // routes. Only the Firebase Admin SDK should ever touch these
    // documents — never the client. The 6-digit code IS the secret.
    match /pairingCodes/{code} {
      allow read, write: if false;
    }

    // ─── schools/{schoolId} ─────────────────────────────────────────
    // The school owner (principal/coordinator) has uid === schoolId.
    // Schools don't pair students — kids reach /c/<CODE> WITHOUT auth.
    // So only the owner reads the school doc + every classroom + every
    // search log. Read only from the browser (2026-11-13): the owner's
    // edits (name, daily summary, classroom details) go through
    // /api/schools/update, and the rest through the other server routes.
    match /schools/{schoolId} {
      allow read: if isOwnerOf(schoolId);
      allow write: if false;

      // Classrooms: owner reads. Creation goes through
      // /api/schools/create-classroom (unique code + lookup doc written
      // together), edits through /api/schools/update, deletion through
      // its own server route.
      match /classrooms/{classroomId} {
        allow read: if isOwnerOf(schoolId);
        allow write: if false;

        // Search logs: owner reads (this is the teacher view at
        // /classroom/{id}). All writes happen through the Admin SDK
        // via /api/classroom/log-search (anonymous kid POST). No
        // direct client writes — kids aren't authenticated.
        match /searches/{searchId} {
          allow read: if isOwnerOf(schoolId);
          allow write: if false;
        }
      }
    }

    // ─── classroomCodes/{code} ──────────────────────────────────────
    // Top-level lookup table mapping 6-char class code → {schoolId,
    // classroomId}. Read by /api/classroom/lookup so a kid landing on
    // /c/<CODE> can resolve to a school+classroom without scanning
    // every school. Writes are server-only (Admin SDK via
    // /api/schools/create-classroom) because the lookup doc must be
    // written atomically with the classroom doc.
    match /classroomCodes/{code} {
      allow read, write: if false;
    }

    // ─── Existing collections (keep whatever was already deployed) ──
    // If your console has additional rules for searches, popular-words,
    // reports, admin, etc., preserve them by pasting them ABOVE this
    // closing brace.
  }
}
